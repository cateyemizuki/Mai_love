# ============================================================
# 麦麦恋人（MaiLover）- 忽略规则
# 发布目录只包含运行必需文件；测试与开发文件只保留在本地，
# 不进入版本库 / 不随插件上传（见插件中心发布流程）。
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.python-version

# ── 运行时生成的数据文件（首次启动自动创建）─────────────────
data/

# ── 测试与开发文件（不随插件发布；本地保留运行）─────────────
tests/
conftest.py
.pytest_cache/
.coverage
.coverage.*
htmlcov/
scratch/

# ── 日志与环境变量 ──────────────────────────────────────────
*.log
.env
.env.*
!.env.example

# ── 本机专属 / 开发残留 ─────────────────────────────────────
.claude/
*.bak

# ── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
